  continue\n            stack = [(r, c)]\n            seen.add((r, c))\n            cells = []\n            while stack:\n                y, x = stack.pop()\n                cells.append((y, x))\n                for dy, dx in ((1,0),(-1,0),(0,1),(0,-1)):\n                    p = (y+dy, x+dx)\n                    if 0 <= p[0] < h and 0 <= p[1] < w and p not in seen and grid[p[0]][p[1]] == col:\n                        seen.add(p)\n                        stack.append(p)\n            comps.append((col, cells))\n\n    def canonical(cells):\n        pts = cells\n        forms = []\n        for flip in (1, -1):\n            for k in range(4):\n                a = []\n                for y, x in pts:\n                    x *= flip\n                    for _ in range(k):\n                        y, x = x, -y\n                    a.append((y, x))\n                my, mx = min(y for y,x in a), min(x for y,x in a)\n                forms.append(frozenset((y-my,x-mx) for y,x in a))\n        return min(forms, key=lambda x: sorted(x))\n\n    # Isolated singleton markers that have a shape-identical colored counterpart\n    # use the counterpart's color when it is the only matching singleton.\n    singles = [(col, cells) for col, cells in comps if len(cells) == 1]\n    for col, cells in singles:\n        r, c = cells[0]\n        candidates = [(other, oc) for other, oc in comps\n                      if other != col and len(oc) == 1]\n        if candidates:\n            # In these diagrams singleton marks are recolored to the color of\n            # the largest nearby connected object.\n            nearby = []\n            for other, oc in comps:\n                if other == col:\n                    continue\n                d = min(abs(r-y)+abs(c-x) for y,x in oc)\n                nearby.append((d, -len(oc), other))\n            if nearby:\n                target = min(nearby)[2]\n                out[r][c] = target\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action"