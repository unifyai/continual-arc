for _ in range(H)]\n    \n    # Fill shapes\n    # Sort by size descending to handle potential overlaps (prioritizing larger shapes)\n    valid_shapes.sort(key=lambda s: s[5], reverse=True)\n    \n    for min_r, min_c, max_r, max_c, color, size in valid_shapes:\n        for r in range(min_r, max_r + 1):\n            for c in range(min_c, max_c + 1):\n                result[r][c] = color\n                \n    return result\n```\n```json\n{\"action\": \"submit\"}\n```","steps":[],"action":{"type":"submit","correct":true}}]}