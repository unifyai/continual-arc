th exactly one action JSON on the last line.","reply":"```python\ndef transform(grid):\n    h, w = len(grid), len(grid[0])\n    out = [row[:] for row in grid]\n\n    # A solid block is the embedded rectangle; mark blocks with at least\n    # four rows and four columns. Sliding windows cover the full block.\n    for rh in range(4, h + 1):\n        for rw in range(4, w + 1):\n            for r in range(h - rh + 1):\n                for c in range(w - rw + 1):\n                    color = grid[r][c]\n                    if all(grid[i][j] == color\n                           for i in range(r, r + rh)\n                           for j in range(c, c + rw)):\n                        for i in range(r, r + rh):\n                            for j in range(c, c + rw):\n                                out[i][j] = 4\n\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit","correct":true}}]}