mponents.\n    seen = set()\n    comps = []\n    for r in range(h):\n        for c in range(w):\n            color = g[r][c]\n            if color == 0 or (r, c) in seen:\n                continue\n            stack = [(r, c)]\n            seen.add((r, c))\n            cells = []\n            while stack:\n                rr, cc = stack.pop()\n                cells.append((rr, cc))\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    p = (rr + dr, cc + dc)\n                    if (0 <= p[0] < h and 0 <= p[1] < w\n                            and p not in seen and g[p[0]][p[1]] == color):\n                        seen.add(p)\n                        stack.append(p)\n            comps.append((color, cells))\n\n    # Find a clean L-shaped marker, then recolor the component in its\n    # open quadrant that it points toward.\n    marker = None\n    for color, cells in comps:\n        rs = [r for r, c in cells]\n        cs = [c for r, c in cells]\n        r0, r1, c0, c1 = min(rs), max(rs), min(cs), max(cs)\n        shape = set(cells)\n        for cr, cc in ((r0, c0), (r0, c1), (r1, c0), (r1, c1)):\n            expected = set()\n            if cr == r0:\n                expected.update((r0, c) for c in range(c0, c1 + 1))\n            else:\n                expected.update((r1, c) for c in range(c0, c1 + 1))\n            if cc == c0:\n                expected.update((r, c0) for r in range(r0, r1 + 1))\n            else:\n                expected.update((r, c1) for r in range(r0, r1 + 1))\n            if shape == expected and r0 != r1 and c0 != c1:\n                marker = (color, cells, cr, cc)\n                break\n        if marker:\n            break\n\n    if marker:\n        color, cells, cr, cc = marker\n        # The L arms extend from its corner; select an object extending\n        # into the opposite (open) quadrant.\n        arm_r = -1 if cr == max(r for r, c in cells) else 1\n        arm_c = -1 if cc == max(c for r, c in cells