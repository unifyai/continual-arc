                      break\n            if marker:\n                break\n        if marker:\n            break\n\n    if marker is None:\n        return out\n    dr, dc, vals = marker\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == noise:\n                for i, val in enumerate(vals):\n                    rr, cc = r + (i-1)*dr, c + (i-1)*dc\n                    if 0 <= rr < h and 0 <= cc < w:\n                        out[rr][cc] = val\n    return out\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit"}}]}