 4 4\n4 4 4 4 4 4 4 4 4 4 4 4 4 4 4 8 4 4 4 4 4 4 4 4 4\nWrong attempts used: 0/8. Demo requests used: 3/8.\nReply with exactly one action JSON on the last line.","reply":"```python\ndef transform(grid):\n    h, w = len(grid), len(grid[0])\n    background = grid[0][0]\n    special = next((v for row in grid for v in row if v != background), None)\n    if special is None:\n        return [row[:] for row in grid]\n\n    points = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == special]\n\n    # Compute the convex hull of the special-color cells.\n    pts = sorted(set((c, r) for r, c in points))\n\n    def cross(o, a, b):\n        return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])\n\n    if len(pts) < 3:\n        hull = pts\n    else:\n        lower = []\n        for p in pts:\n            while len(lower) >= 2 and cross(lower[-2], lower[-1], p) <= 0:\n                lower.pop()\n            lower.append(p)\n        upper = []\n        for p in reversed(pts):\n            while len(upper) >= 2 and cross(upper[-2], upper[-1], p) <= 0:\n                upper.pop()\n            upper.append(p)\n        hull = lower[:-1] + upper[:-1]\n\n    def inside_or_boundary(x, y):\n        if len(hull) == 1:\n            return (x, y) == hull[0]\n        if len(hull) == 2:\n            a, b = hull\n            return cross(a, b, (x, y)) == 0 and min(a[0], b[0]) <= x <= max(a[0], b[0]) and min(a[1], b[1]) <= y <= max(a[1], b[1])\n        sign = None\n        for i, a in enumerate(hull):\n            b = hull[(i + 1) % len(hull)]\n            z = cross(a, b, (x, y))\n            if z:\n                s = z > 0\n                if sign is None:\n                    sign = s\n                elif sign != s:\n                    return False\n        return True\n\n    out = [row[:] for row in grid]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == background and inside_or_boundary(c, r):\n                out[r][c] = 3\n    return out\n``