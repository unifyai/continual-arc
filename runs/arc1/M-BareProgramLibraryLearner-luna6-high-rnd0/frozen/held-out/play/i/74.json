 # The completed picture is symmetric across its main diagonal.\n    for r in range(n):\n        for c in range(m):\n            if grid[r][c] == 6 and c < n and grid[c][r] != 6:\n                out[r][c] = grid[c][r]\n\n    # Where a masked cell and its transpose are both masked, use repeated\n    # rows or columns elsewhere in the grid to recover the shared pattern.\n    for _ in range(n + m):\n        updates = {}\n        for r in range(n):\n            for c in range(m):\n                if out[r][c] != 6:\n                    continue\n\n                votes = []\n                for k in range(n):\n                    if k == r or out[k][c] == 6:\n                        continue\n                    overlap = [(j, j) for j in range(m)\n                               if out[r][j] != 6 and out[k][j] != 6]\n                    if len(overlap) < 8:\n                        continue\n                    if all(out[r][j] == out[k][j] for j, _ in overlap):\n                        votes.append((len(overlap), out[k][c]))\n\n                for k in range(m):\n                    if k == c or out[r][k] == 6:\n                        continue\n                    overlap = [(i, i) for i in range(n)\n                               if out[i][c] != 6 and out[i][k] != 6]\n                    if len(overlap) < 8:\n                        continue\n                    if all(out[i][c] == out[i][k] for i, _ in overlap):\n                        votes.append((len(overlap), out[r][k]))\n\n                if votes:\n                    best = max(score for score, _ in votes)\n                    top = [value for score, value in votes if score == best]\n                    if len(set(top)) == 1:\n                        updates[r, c] = top[0]\n\n        if not updates:\n            break\n        for (r, c), value in updates.items():\n            out[r][c] = value\n\n    return out\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit","correct":true}}]}