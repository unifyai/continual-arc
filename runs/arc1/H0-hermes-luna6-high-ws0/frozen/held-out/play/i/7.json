8):\n  if r in seps or c in seps: v=8\n  elif r>=25 or c>=25: v=0\n  else:\n   tile=(r//5,c//5)\n   a=tile in filled[2]; b=tile in filled[3]\n   v=6 if a and b else 2 if a else 3 if b else 0\n  row.append(v)\n grid.append(row)\nimport json\nprint(json.dumps({'action':'submit','grid':grid},separators=(',',':')))","t":1792607601.5732048,"output":"{\"status\": \"success\", \"output\": \"{\\\"action\\\":\\\"submit\\\",\\\"grid\\\":[[0,0,0,0,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[0,0,0,0,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[0,0,0,0,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[0,0,0,0,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8],[2,2,2,2,8,2,2,2,2,8,6,6,6,6,8,2,2,2,2,8,2,2,2,2,8,0,0,0],[2,2,2,2,8,2,2,2,2,8,6,6,6,6,8,2,2,2,2,8,2,2,2,2,8,0,0,0],[2,2,2,2,8,2,2,2,2,8,6,6,6,6,8,2,2,2,2,8,2,2,2,2,8,0,0,0],[2,2,2,2,8,2,2,2,2,8,6,6,6,6,8,2,2,2,2,8,2,2,2,2,8,0,0,0],[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8],[2,2,2,2,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[2,2,2,2,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[2,2,2,2,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[2,2,2,2,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8],[2,2,2,2,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[2,2,2,2,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[2,2,2,2,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[2,2,2,2,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8],[0,0,0,0,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[0,0,0,0,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[0,0,0,0,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[0,0,0,0,8,0,0,0,0,8,3,3,3,3,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8,8],[0,0,0,0,8,0,0,0,0,8,0,0,0,0,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[0,0,0,0,8,0,0,0,0,8,0,0,0,0,8,0,0,0,0,8,0,0,0,0,8,0,0,0],[0