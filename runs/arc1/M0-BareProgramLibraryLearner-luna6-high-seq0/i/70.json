3 3 3 3 3 3 3 3 3 3 3 3 4 3\n4 3 3 3 3 3 3 3 3 3 3 3 3 4 3 3 3 3 3 3 3 3 3 3 3 3 4 3\n4 3 3 3 3 3 3 3 3 3 3 3 3 4 3 3 3 3 3 3 3 3 3 3 3 3 4 3\n7 4 4 4 4 4 4 4 4 4 4 4 4 7 4 4 4 4 4 4 4 4 4 4 4 4 4 4\n4 3 3 3 3 3 3 3 3 3 3 3 3 4 3 3 3 3 3 3 3 3 3 3 3 3 4 3\n4 3 3 3 3 3 3 3 3 3 3 3 3 4 3 3 3 3 3 3 3 3 3 3 3 3 4 3\nWrong attempts used: 0/8. Demo requests used: 5/8.\nReply with exactly one action JSON on the last line.","reply":"```python\ndef transform(grid):\n    from collections import Counter\n\n    h, w = len(grid), len(grid[0])\n    counts = Counter(v for row in grid for v in row)\n    base = counts.most_common(1)[0][0]\n\n    # Grid boundaries are the rows and columns dominated by non-background cells.\n    rows = [r for r in range(h)\n            if sum(v != base for v in grid[r]) >= 0.60 * w]\n    cols = [c for c in range(w)\n            if sum(grid[r][c] != base for r in range(h)) >= 0.60 * h]\n\n    if len(rows) < 2 or len(cols) < 2:\n        return [row[:] for row in grid]\n\n    # The most common non-background color on the grid lines is the separator color.\n    line_colors = Counter()\n    for r in rows:\n        line_colors.update(v for v in grid[r] if v != base)\n    for c in cols:\n        line_colors.update(grid[r][c] for r in range(h) if grid[r][c] != base)\n    separator = line_colors.most_common(1)[0][0]\n\n    out = []\n    for r1, r2 in zip(rows, rows[1:]):\n        new_row = []\n        for c1, c2 in zip(cols, cols[1:]):\n            corners = (grid[r1][c1], grid[r1][c2],\n                       grid[r2][c1], grid[r2][c2])\n            if corners[0] == corners[1] == corners[2] == corners[3] \\\n                    and corners[0] != separator:\n                new_row.append(corners[0])\n            else:\n                new_row.append(base)\n        out.append(new_row)\n\n    while out and all(v == base for v in out[0]):\n        out.pop(0)\n    while out and all(v == base for v in out[-1]):\n        out.pop()\n    while out and all(row[0] == base for row in out):\n        for row in out:\n            row.pop(0)\n    while out and all(row[-1] == base for row in out):\n        for row in out:\n            row.pop()\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit"}}]}