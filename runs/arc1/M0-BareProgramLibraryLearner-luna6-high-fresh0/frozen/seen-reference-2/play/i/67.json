 for row in grid for v in row)\n    bg = counts.most_common(1)[0][0]\n    out = [row[:] for row in grid]\n\n    # Find horizontal bands of rows containing the foreground pattern.\n    active = [any(v != bg for v in row) for row in grid]\n    bands = []\n    r = 0\n    while r < h:\n        if not active[r]:\n            r += 1\n            continue\n        start = r\n        while r < h and active[r]:\n            r += 1\n        bands.append((start, r))\n\n    def xmax(band):\n        return max(c for rr in range(band[0], band[1])\n                   for c in range(w) if grid[rr][c] != bg)\n\n    # Match two bands with the same height. The shorter band is the\n    # incomplete copy; extend it using the pattern in the longer one.\n    candidates = []\n    for i in range(len(bands)):\n        for j in range(i + 1, len(bands)):\n            a, b = bands[i], bands[j]\n            if a[1] - a[0] != b[1] - b[0]:\n                continue\n            xa, xb = xmax(a), xmax(b)\n            if xa == xb:\n                continue\n            if xa < xb:\n                target, source, xt = a, b, xa\n            else:\n                target, source, xt = b, a, xb\n\n            # Find the horizontal offset that best aligns their existing\n            # portions. Positive offset means source pixels map rightward.\n            best = None\n            for dx in range(-3, 4):\n                matches = 0\n                total = 0\n                for k in range(target[1] - target[0]):\n                    tr = target[0] + k\n                    sr = source[0] + k\n                    for c in range(xt + 1):\n                        sc = c - dx\n                        sv = grid[sr][sc] if 0 <= sc < w else bg\n                        matches += (grid[tr][c] == sv)\n                        total += 1\n                score = matches / total if total else 0\n                # Prefer zero shift when the fit is otherwise equal.\n                key = (score, -abs(dx))\n                if best is None or key > best[0]:\n                    best = (key, dx)\n\n            dx = best[1]\n            # Similarity favors pairing the two copies when several bands\n            # of the same height occur.\n            candidates.append((best[0][0], target, source, xt, dx))\n\n    if not candidates:\n        return out\n\n    _, target, source, xt, dx = max(candidates, key=lambda x: x[0])\n    for k in range(target[1] - target[0]):\n        tr = target[0] + k\n        sr = source[0] + k\n        for c in range(xt + 1, w):\n            sc = c - dx\n            if 0 <= sc < w and grid[sr][sc] != bg and grid[tr][c] == bg:\n                out[tr][c] = 1\n    return out\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit","correct":true}}]}