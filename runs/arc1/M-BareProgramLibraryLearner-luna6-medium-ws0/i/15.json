 []\n    for c in range(w):\n        if grid[0][c] != bg:\n            edges.append((0, c, \"down\"))\n        if grid[h-1][c] != bg:\n            edges.append((h-1, c, \"up\"))\n    for r in range(h):\n        if grid[r][0] != bg:\n            edges.append((r, 0, \"right\"))\n        if grid[r][w-1] != bg:\n            edges.append((r, w-1, \"left\"))\n\n    # A paired marker is a consecutive pair of identical non-background border cells.\n    beams = set()\n    for r, c, direction in edges:\n        dr, dc = {\"down\": (1, 0), \"up\": (-1, 0),\n                  \"right\": (0, 1), \"left\": (0, -1)}[direction]\n        if direction in (\"down\", \"up\"):\n            rr = r\n            if c+1 < w and grid[rr][c+1] == grid[rr][c] and grid[rr][c] != bg:\n                # Use the endpoint facing the interior, or align with the lone point.\n                cc = c+1 if pc == c+1 else c\n                if c == w-1:\n                    cc = c-1\n                beams.add((rr, cc, direction))\n        else:\n            cc = c\n            if r+1 < h and grid[r+1][cc] == grid[r][cc] and grid[r][cc] != bg:\n                rr = r+1 if pr == r+1 else r\n                if r == h-1:\n                    rr = r-1\n                beams.add((rr, cc, direction))\n\n    out[pr][pc] = 4\n    for r, c, direction in beams:\n        dr, dc = {\"down\": (1, 0), \"up\": (-1, 0),\n                  \"right\": (0, 1), \"left\": (0, -1)}[direction]\n        r += dr\n        c += dc\n        while 0 <= r < h and 0 <= c < w:\n            if (r, c) == (pr, pc):\n                out[r][c] = 4\n                break\n            out[r][c] = color\n            r += dr\n            c += dc\n    return out\n```\n\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit","correct":false,"grid":[[9,9,9,0,0,9,9,9,9,9,9,9,9,9,9,9,9,1],[9,9,9,1,9,9,9,9,9,9,9,9,9,9,9,9,9,1],[9,9,9,1,9,9,9,9,9,9,9,9,9,9,9,9,9,1],[9,9,9,1,9,9,9,9,9,9,9,9,9,9,9,9,9,1],[9,9,9,1,9,9,9,9,9,9,9,9,9,9,9,9,9,1],[9,9,9