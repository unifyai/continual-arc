                       for dx in (-1, 1) if (y + dy, x + dx) in comp]\n                if len(neighbors) != 1:\n                    continue\n\n                # Endpoints touching another color orthogonally are part of\n                # the local motif rather than the extending end.\n                if any(0 <= y + dy < h and 0 <= x + dx < w\n                       and grid[y + dy][x + dx] not in (bg, color)\n                       for dy, dx in ((-1, 0), (1, 0), (0, -1), (0, 1))):\n                    continue\n\n                ny, nx = neighbors[0]\n                dy, dx = y - ny, x - nx\n                yy, xx = y + dy, x + dx\n                while 0 <= yy < h and 0 <= xx < w and out[yy][xx] == bg:\n                    out[yy][xx] = color\n                    yy += dy\n                    xx += dx\n\n    return out\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit","correct":true}}]}