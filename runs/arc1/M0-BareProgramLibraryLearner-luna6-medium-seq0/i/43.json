n(grid), len(grid[0])\n    from collections import Counter\n    bg = Counter(v for row in grid for v in row).most_common(1)[0][0]\n    out = [row[:] for row in grid]\n\n    # Find diagonal runs of at least two matching cells and extend each run\n    # outward in both directions, stopping at the grid edge or another color.\n    for dr, dc in ((1, 1), (1, -1)):\n        for r in range(h):\n            for c in range(w):\n                color = grid[r][c]\n                if color == bg:\n                    continue\n                pr, pc = r - dr, c - dc\n                if 0 <= pr < h and 0 <= pc < w and grid[pr][pc] == color:\n                    continue  # not the start of this run\n                rr, cc = r, c\n                length = 1\n                while (0 <= rr + dr < h and 0 <= cc + dc < w\n                       and grid[rr + dr][cc + dc] == color):\n                    rr += dr\n                    cc += dc\n                    length += 1\n                if length < 2:\n                    continue\n\n                # Extend before the run.\n                er, ec = r - dr, c - dc\n                while 0 <= er < h and 0 <= ec < w and grid[er][ec] == bg:\n                    out[er][ec] = color\n                    er -= dr\n                    ec -= dc\n\n                # Extend after the run.\n                er, ec = rr + dr, cc + dc\n                while 0 <= er < h and 0 <= ec < w and grid[er][ec] == bg:\n                    out[er][ec] = color\n                    er += dr\n                    ec += dc\n    return out\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit","correct":true,"grid":[[4,4,4,4,4,4,4,4,4,4,4,4,4,4,4,3,4,4],[4,4,4,4,4,4,4,4,4,4,4,4,4,4,3,4,4,4],[4,4,4,4,4,4,4,4,4,4,4,4,4,3,4,4,4,4],[4,4,4,4,4,4,4,4,4,4,4,4,3,4,4,4,4,4],[4,4,4,4,4,4,4,4,4,4,4,3,4,4,4,4,4,4],[4,4,4,4,4,4,4,4,4,6,3,4,4,4,4,4,4,4],[4,4,4,4,4,4,4,4,4,6,5,4,4,4,4,4,4,4],[4,4,4,4,4,4,4,4,4,4,4,5,4,4,4,4,4,4],[4,4,4,4,4,4,4,4,4,4,4,4,5,4,4,