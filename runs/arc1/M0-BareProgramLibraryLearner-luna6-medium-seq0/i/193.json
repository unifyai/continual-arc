           shift = gr - 1 - rmax\n        else:\n            shift = gr + 1 - rmin\n\n        for r, c in obj:\n            out[r][c] = bg\n        moved = [(r + shift, c, grid[r][c]) for r, c in obj]\n        for r, c, color in moved:\n            out[r][c] = color\n\n        if shift >= 0:\n            trail = min(r for r, c, _ in moved) - 1\n        else:\n            trail = max(r for r, c, _ in moved) + 1\n        if 0 <= trail < h:\n            out[trail] = [8] * w\n\n    elif guide_cols:\n        gc = guide_cols[0]\n        cmin = min(c for r, c in obj)\n        cmax = max(c for r, c in obj)\n        if gc > cmax:\n            shift = gc - 1 - cmax\n        else:\n            shift = gc + 1 - cmin\n\n        for r, c in obj:\n            out[r][c] = bg\n        moved = [(r, c + shift, grid[r][c]) for r, c in obj]\n        for r, c, color in moved:\n            out[r][c] = color\n\n        if shift >= 0:\n            trail = min(c for r, c, _ in moved) - 1\n        else:\n            trail = max(c for r, c, _ in moved) + 1\n        if 0 <= trail < w:\n            for r in range(h):\n                out[r][trail] = 8\n\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit"}}]}