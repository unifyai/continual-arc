`python\ndef transform(grid):\n    h, w = len(grid), len(grid[0])\n    counts = {}\n    for row in grid:\n        for v in row:\n            counts[v] = counts.get(v, 0) + 1\n\n    marker = min((c for c in counts if c != 0), key=lambda c: counts[c])\n    background = max((c for c in counts if c != marker), key=counts.get)\n\n    pts = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == marker]\n    r0 = min(r for r, c in pts)\n    r1 = max(r for r, c in pts)\n    c0 = min(c for r, c in pts)\n    c1 = max(c for r, c in pts)\n    shape = [(r-r0, c-c0) for r, c in pts]\n    sh, sw = r1-r0+1, c1-c0+1\n\n    out = [row[:] for row in grid]\n    for top in range(h-sh+1):\n        for left in range(w-sw+1):\n            if all(grid[top+dr][left+dc] == background for dr, dc in shape):\n                for dr, dc in shape:\n                    out[top+dr][left+dc] = marker\n    return out\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit"}},{"step":110,"kind":"reprompt","phase":"act","t0":1792554656.893,"t1":1792554664.553,"alias":"task-f706d4be","message":"Your program was checked on demo pair 2 at no cost and its output is wrong. It gave\n0 0 8 7 7 7 0 0 0 0 0 8 0 0 8 0 0 0\n0 8 8 8 7 7 7 7 0 8 8 8 8 8 0 8 0 8\n8 8 0 0 0 7 7 7 0 0 0 0 0 7 7 7 0 0\n0 8 8 0 0 7 7 7 7 7 0 0 0 0 7 0 0 8\n8 8 0 8 0 7 7 7 7 8 0 0 0 8 8 7 8 8\n0 0 7 7 7 0 7 7 0 7 7 7 7 7 7 0 8 0\n0 8 0 7 7 7 7 7 7 0 7 7 7 7 0 0 8 0\n7 7 7 7 7 0 0 7 0 7 7 7 0 0 7 8 8 0\n0 7 0 7 7 7 0 7 7 7 7 0 7 0 8 8 0 8\n7 7 7 0 7 8 8 7 7 7 0 7 8 0 0 0 0 0\n8 7 0 8 8 7 8 8 7 7 7 7 8 8 8 0 8 8\n7 7 7 0 0 8 7 7 7 7 7 0 0 0 0 8 0 8\n8 7 0 7 7 7 0 7 0 8 0 7 0 8 8 0 8 8\n7 7 7 8 7 0 8 0 7 8 8 0 8 0 8 8 0 8\n0 7 8 0 7 7 7 8 0 8 7 7 7 7 7 7 0 0\n8 8 7 0 0 7 0 7 7 7 7 7 7 0 7 7 7 7\n8 0 0 0 7 7 7 7 7 7 0 0 7 7 7 7 7 0\n8 7 7 7 0 7 0 7 0 7 7 7 7 0 7 8 0 7\n0 0 7 0 8 0 7 7 7 0 7 7 7 7 8 7 0 8\n8 0 8 7 7 7 0 7 7 7 7 7 7 0 8 8 8 8\n8 7 7 7 7 0 0 0 7 0 7 7 7 7 7 0 0 0\n8 8 7 7 0 7 8 8 0 7 7 7 7 7 0 0 0 0\n8 8 0 7 7 