, w = len(grid), len(grid[0])\n\n    # Extend each horizontal stripe's rightmost colored cell to the edge.\n    # The background is the most common grid color.\n    from collections import Counter\n    bg = Counter(v for row in grid for v in row).most_common(1)[0][0]\n\n    for r, row in enumerate(grid):\n        colored = [c for c, v in enumerate(row) if v != bg]\n        if not colored:\n            continue\n        end = max(colored)\n        # Only the final background cell(s) after a stripe are changed.\n        for c in range(end + 1, w):\n            out[r][c] = 1\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit"}}]}