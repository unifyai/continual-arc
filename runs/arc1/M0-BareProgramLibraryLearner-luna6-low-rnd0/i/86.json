t known:\n        return [row[:] for row in grid]\n\n    # Find the shortest vertical period consistent with all nonblank stripes.\n    period = h\n    for p in range(1, h + 1):\n        if all(known[a] == known[b]\n               for a in known for b in known\n               if a % p == b % p):\n            period = p\n            break\n\n    motif = {}\n    for r, color in known.items():\n        motif[r % period] = color\n\n    # Any motif positions not specified by the clues remain blank.\n    blank = 0\n    return [[motif.get(r % period, blank)] * w for r in range(h)]\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit"}}]}