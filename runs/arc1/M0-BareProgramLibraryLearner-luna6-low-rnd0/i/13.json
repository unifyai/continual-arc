         counts[v] = counts.get(v, 0) + 1\n    # The background is the most frequent color; the small component is the stamp.\n    bg = max(counts, key=counts.get)\n    colors = [v for v in counts if v != bg]\n    stamp_color = min(colors, key=lambda v: counts[v])\n    pts = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == stamp_color]\n\n    # Keep just the connected component containing the uppermost-leftmost stamp cell.\n    start = min(pts)\n    seen = {start}\n    q = deque([start])\n    while q:\n        r, c = q.popleft()\n        for dr, dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            p = (r+dr, c+dc)\n            if p in pts and p not in seen:\n                seen.add(p)\n                q.append(p)\n    pts = sorted(seen)\n    r0, c0 = min(r for r,c in pts), min(c for r,c in pts)\n    shape = [(r-r0, c-c0) for r,c in pts]\n    sh, sw = max(r for r,c in shape)+1, max(c for r,c in shape)+1\n\n    out = [row[:] for row in grid]\n    for r in range(h-sh+1):\n        for c in range(w-sw+1):\n            if all(grid[r+dr][c+dc] == 0 for dr,dc in shape):\n                for dr,dc in shape:\n                    out[r+dr][c+dc] = stamp_color\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit"}},{"step":13,"kind":"reprompt","phase":"act","t0":1792546257.916,"t1":1792546274.556,"alias":"task-f706d4be","message":"Your program was checked on demo pair 2 at no cost and its output is wrong. It gave\n0 0 6 0 4 6 6 6 6 6 6 6 6 6 6 6 6 0\n6 6 6 6 4 6 6 4 4 6 6 6 6 6 6 4 6 6\n0 6 6 6 6 6 6 4 4 6 6 0 4 4 6 4 6 6\n6 6 6 6 0 6 6 6 4 0 6 6 4 4 6 6 0 6\n6 0 6 4 6 6 4 6 6 6 6 6 4 6 6 4 6 0\n6 6 6 4 4 4 4 0 6 6 0 0 6 4 6 4 6 6\n6 6 6 6 4 4 6 6 4 6 6 6 4 4 0 4 6 6\n6 6 0 0 4 4 4 6 4 6 6 6 4 4 6 6 6 6\n6 0 6 6 4 4 4 4 6 6 4 6 4 4 0 6 6 6\n6 6 6 6 6 4 4 4 4 6 4 6 4 6 6 6 6 6\n4 6 6 6 4 4 4 4 4 4 4 4 6 4 6 6 0 0\n4 6 6 6 4 4 4 4 4 4 4 4 4 4 0 6 6 6\n6 6 6 4 4 4 4 6 6 4 4 4 4 6 6 6 6 6\n6 4 4 4 4 4 6 0 6 6 6 6 6 6 6 6 6 6\n4 4 4 4 6 4 4 6 6 