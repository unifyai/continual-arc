ited[nr][nc]:\n                            visited[nr][nc] = True\n                            q.append((nr, nc))\n                \n                # Calculate bounding box\n                r_min = min(p[0] for p in comp_cells)\n                r_max = max(p[0] for p in comp_cells)\n                c_min = min(p[1] for p in comp_cells)\n                c_max = max(p[1] for p in comp_cells)\n                \n                # Check if it forms a hollow frame (border is color, interior is bg)\n                # Interior dimensions\n                inner_h = r_max - r_min - 1\n                inner_w = c_max - c_min - 1\n                \n                # If interior is empty (too small to be a frame or just a line), skip filling\n                # We require at least 1x1 interior to be a valid frame to be filled in ARC style\n                if inner_h <= 0 or inner_w <= 0:\n                    continue\n                \n                # Check border\n                is_frame = True\n                # Check exterior border\n                for k in range(r_min, r_max + 1):\n                    for j in range(c_min, c_max + 1):\n                        # Check corners or edges\n                        if k == r_min or k == r_max or j == c_min or j == c_max:\n                            if grid[k][j] != color:\n                                is_frame = False\n                                break\n                    if not is_frame:\n                        break\n                \n                if not is_frame:\n                    continue\n                \n                # Check interior is all background\n                for k in range(r_min + 1, r_max):\n                    for l in range(c_min + 1, c_max):\n                        if grid[k][l] != bg:\n                            is_frame = False\n                            break\n                    if not is_frame:\n                        break\n                \n                if is_frame:\n                    # Determine fill color based on interior dimensions parity\n                    # Odd (1, 3, 5...) -> 7\n                    # Even (2, 4...) -> 2\n                    if (inner_w % 2 != 0) or (inner_h % 2 != 0):\n                        fill_color = 7\n                    else:\n                        fill_color = 2\n                    \n                    # Fill interior\n                    for k in range(r_min + 1, r_max):\n                        for l in range(c_min + 1, c_max):\n                            result[k][l] = fill_color\n\n    return result\n```\n\n{\"action\": \"submit\", \"grid\": [[3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 8, 8, 8, 8, 8, 8, 8, 3, 3], [3, 3, 3, 3, 3, 3, 3, 1, 1, 1, 3, 8, 7, 7, 7, 7, 7, 8, 3, 3], [6, 6, 6, 3, 3, 3, 3, 1, 7, 1, 3, 8, 7, 7, 7, 7, 7, 8, 3, 3], [6, 7, 6, 3, 3, 3, 3, 1, 1, 1, 3, 8, 7, 7, 7, 7, 7, 8, 3, 3], [6, 6, 6, 3, 3, 3, 3, 3, 3, 3, 3, 8, 7, 7, 7, 7, 7, 8, 3, 3], [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 8, 7, 7, 7, 7, 7, 8, 3, 3], [3, 6, 6, 6, 3, 3, 3, 3, 3, 3, 3, 8, 8, 8, 8, 8, 8, 8, 3, 3], [3, 6, 7, 6, 3, 5, 5, 5, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3], [3, 6, 6, 6, 3, 5, 2, 5, 3, 2, 2, 2, 2, 2, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 5, 5, 5, 3, 2, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 3, 3, 3, 3, 2, 3, 3, 3, 3, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 3, 3, 3, 3, 2, 2, 2, 2, 2, 2, 3, 3, 3, 3, 3], [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]]}","steps":[],"action":{"type":"submit","grid":[[3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3,3],[3,3,3,3,3,3,3,3,3,3,3,8,8,8,8,8,8,8,3,3],[3,3,3,3,3,3,3,1,1,1,3,8,7,7,7,7,7,8,3,3],[6,6,6,3,3,3,3,1,7,1,3,8,7,7,7,7,7,8,3,3],[6,7,6,3,3,3,3,1,1,1,3,8,7,7,7,7,7,8,3,3],[6,6,6,3,3,3,3,3,3,3,3,8,7,7,7,7,7,8,3,3],[3,3,3,3,3,3,3,3,3,3,3,8,7,7,7,7,7,8,3,3],[3,6,6,6,3,3,3,3,3,3,3,8,8,8,8,8,8,8,3,3