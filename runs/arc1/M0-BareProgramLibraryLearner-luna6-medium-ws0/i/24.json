\n            if grid[r][c] == bg or (r, c) in seen:\n                continue\n            color = grid[r][c]\n            stack = [(r, c)]\n            seen.add((r, c))\n            cells = set()\n            while stack:\n                y, x = stack.pop()\n                cells.add((y, x))\n                for p in ((y-1, x), (y+1, x), (y, x-1), (y, x+1)):\n                    py, px = p\n                    if 0 <= py < h and 0 <= px < w and p not in seen and grid[py][px] == color:\n                        seen.add(p)\n                        stack.append(p)\n            comps.append((color, cells))\n\n    def is_l(cells):\n        # An L-shaped component has one horizontal and one vertical arm\n        # meeting at a corner, with few or no cells away from those arms.\n        minr = min(r for r, c in cells)\n        maxr = max(r for r, c in cells)\n        minc = min(c for r, c in cells)\n        maxc = max(c for r, c in cells)\n        for cr in (minr, maxr):\n            for cc in (minc, maxc):\n                arm = {(r, c) for r, c in cells if r == cr or c == cc}\n                if len(arm) == len(cells):\n                    return True\n        return False\n\n    # The long L is the color key.\n    keys = [(len(cells), color, cells) for color, cells in comps\n            if len(cells) >= 6 and is_l(cells)]\n    if not keys:\n        return [row[:] for row in grid]\n    _, key_color, key = max(keys)\n\n    # Select the nearest smaller L-shaped object; this is the object\n    # indicated by the key.\n    kr = sum(r for r, c in key) / len(key)\n    kc = sum(c for r, c in key) / len(key)\n    candidates = []\n    for color, cells in comps:\n        if color == key_color or not is_l(cells):\n            continue\n        # Exclude large keys / filled regions.\n        if len(cells) > len(key) * 0.75:\n            continue\n        cr = sum(r for r, c in cells) / len(cells)\n        cc = sum(c for r, c in cells) / len(cells)\n        gap = min(abs(r-y) + abs