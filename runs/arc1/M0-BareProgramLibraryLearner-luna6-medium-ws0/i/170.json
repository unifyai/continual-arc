                if (q := (k + d) % p) in known), next(iter(known)))\n            out.append([known[k]] * w)\n        return out\n\n    # The colored marks specify a periodic pattern on one of the two\n    # diagonal coordinates: c-r or r+c.\n    choices = []\n    for use_sum in (False, True):\n        coords = [(r + c if use_sum else c - r, color) for r, c, color in pts]\n        best = None\n        for p in range(1, max(h, w) + 1):\n            mapping = {}\n            valid = True\n            for x, color in coords:\n                k = x % p\n                if k in mapping and mapping[k] != color:\n                    valid = False\n                    break\n                mapping[k] = color\n            if valid:\n                best = (p, mapping)\n                break\n        if best is not None:\n            choices.append((best[0], use_sum, best[1]))\n\n    if not choices:\n        color = pts[0][2] if pts else 0\n        return [[color] * w for _ in range(h)]\n\n    _, use_sum, mapping = min(choices, key=lambda x: x[0])\n    p = next((p for p in range(1, max(h, w) + 1)\n              if all((x % p not in {}) for x, _ in [])), 1)\n    # Recover the selected period as the smallest one consistent with marks.\n    coords = [(r + c if use_sum else c - r, color) for r, c, color in pts]\n    for p in range(1, max(h, w) + 1):\n        trial = {}\n        for x, color in coords:\n            k = x % p\n            if k in trial and trial[k] != color:\n                break\n            trial[k] = color\n        else:\n            mapping = trial\n            break\n\n    def color_at(k):\n        k %= p\n        if k in mapping:\n            return mapping[k]\n        for d in range(1, p + 1):\n            q = (k + d) % p\n            if q in mapping:\n                return mapping[q]\n        return 0\n\n    return [[color_at(r + c if use_sum else c - r) for c in range(w)]\n            for r in range(h)]\n```\n{\"action\": \"submit\"}","steps":[],"action"