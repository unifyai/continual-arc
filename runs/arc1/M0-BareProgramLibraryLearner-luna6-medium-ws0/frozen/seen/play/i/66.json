for c in cols for r in range(h)]\n    line_color = modes(line_values)[0]\n\n    interior = [grid[r][c] for r in range(h) if r not in rows\n                for c in range(w) if c not in cols]\n    fill = modes(interior)[0]\n\n    nodes = [[grid[r][c] for c in cols] for r in rows]\n    marked = [(i, j) for i in range(len(rows)) for j in range(len(cols))\n              if nodes[i][j] != line_color]\n    if not marked:\n        return [[fill]]\n\n    r0 = min(i for i, j in marked)\n    r1 = max(i for i, j in marked)\n    c0 = min(j for i, j in marked)\n    c1 = max(j for i, j in marked)\n\n    out = []\n    for i in range(r0, r1):\n        row = []\n        for j in range(c0, c1):\n            a, b = nodes[i][j], nodes[i][j + 1]\n            c, d = nodes[i + 1][j], nodes[i + 1][j + 1]\n            if a == b == c == d and a != line_color:\n                row.append(a)\n            else:\n                row.append(fill)\n        out.append(row)\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit","correct":true}}]}