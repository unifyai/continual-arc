hon\ndef transform(grid):\n    from collections import Counter, deque\n\n    h, w = len(grid), len(grid[0])\n    bg = Counter(v for row in grid for v in row).most_common(1)[0][0]\n    seen = [[False] * w for _ in range(h)]\n    out = [row[:] for row in grid]\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] != bg or seen[r][c]:\n                continue\n\n            q = deque([(r, c)])\n            seen[r][c] = True\n            cells = []\n            while q:\n                cr, cc = q.popleft()\n                cells.append((cr, cc))\n                for nr, nc in ((cr - 1, cc), (cr + 1, cc),\n                               (cr, cc - 1), (cr, cc + 1)):\n                    if (0 <= nr < h and 0 <= nc < w and\n                            grid[nr][nc] == bg and not seen[nr][nc]):\n                        seen[nr][nc] = True\n                        q.append((nr, nc))\n\n            if len(cells) <= 1:\n                continue\n            r0 = min(x for x, _ in cells)\n            r1 = max(x for x, _ in cells)\n            c0 = min(y for _, y in cells)\n            c1 = max(y for _, y in cells)\n\n            # Fill only rectangular cavities with a complete colored border.\n            if len(cells) != (r1 - r0 + 1) * (c1 - c0 + 1):\n                continue\n            if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:\n                continue\n\n            bordered = (\n                all(grid[r0 - 1][c] != bg and grid[r1 + 1][c] != bg\n                    for c in range(c0, c1 + 1)) and\n                all(grid[r][c0 - 1] != bg and grid[r][c1 + 1] != bg\n                    for r in range(r0, r1 + 1))\n            )\n            if bordered:\n                for cr, cc in cells:\n                    out[cr][cc] = 4\n\n    return out\n```\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit"}}]}