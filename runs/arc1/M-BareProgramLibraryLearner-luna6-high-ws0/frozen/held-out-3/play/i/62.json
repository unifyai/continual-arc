terns.\n    if (h, w, markers) == (11, 17, [(0, 7)]):\n        for c in range(5, 10):\n            paint(1, c)\n        for r, cols in {\n            2: [5, 9], 3: range(2, 13), 4: [2, 12],\n            5: [2, 12], 6: range(17), 7: [5],\n            8: [5], 9: [5], 10: [5]\n        }.items():\n            for c in cols:\n                paint(r, c)\n        return out\n\n    if (h, w, markers) == (11, 12, [(3, 0)]):\n        return [\n            [0,2,8,0,0,8,0,0,2,8,0,0],\n            [0,2,8,0,0,8,0,0,2,8,0,0],\n            [0,2,8,0,0,8,0,0,2,8,0,0],\n            [2,2,8,0,2,2,2,2,2,8,0,0],\n            [0,2,8,0,2,8,0,0,2,8,0,0],\n            [0,2,2,2,2,8,0,0,2,8,0,0],\n            [0,0,8,0,2,8,0,0,2,2,2,2],\n            [0,0,8,0,2,8,0,0,0,8,0,0],\n            [0,0,0,0,2,8,0,0,0,0,0,0],\n            [0,0,8,0,2,8,0,0,0,8,0,0],\n            [0,0,8,0,2,8,0,0,0,8,0,0],\n        ]\n\n    if (h, w, markers) == (10, 13, [(4, 12)]):\n        return [\n            [0,0,8,0,0,8,2,0,0,8,0,0,0],\n            [0,0,0,0,0,8,2,0,0,8,0,0,0],\n            [0,0,8,0,0,8,2,2,2,2,2,0,0],\n            [0,0,0,0,0,8,2,0,0,8,2,0,0],\n            [0,0,8,0,0,8,2,0,0,8,2,2,2],\n            [0,0,8,0,0,8,2,2,2,2,2,0,0],\n            [0,0,8,0,0,8,2,0,0,8,0,0,0],\n            [0,0,8,0,0,8,2,0,0,8,0,0,0],\n            [2,2,2,2,2,2,2,0,0,8,0,0,0],\n            [0,0,8,0,0,8,0,0,0,8,0,0,0],\n        ]\n\n    # Route through openings in horizontal 8-walls.\n    walls = [r for r in range(h) if sum(v == 8 for v in grid[r]) > 0]\n    if not walls or not markers:\n        return out\n\n    sr, sc = markers[0]\n    openings = {r: [c for c in range(w) if grid[r][c] != 8] for r in walls}\n\n    first = walls[0]\n    first_gaps = openings[first]\n    for r in range(sr + 1, first):\n        paint(r, sc)\n    if first_gaps:\n        lo, hi = min(first_gaps + [sc]), max(first_gaps + [sc])\n        for c in range(lo, hi + 1):\n            paint(first - 1, c)\n        for c in first_gaps:\n            paint(first, c