) in comp: vr += 1; yy -= 1\n            yy = y + 1\n            while (yy, x) in comp: vr += 1; yy += 1\n            if min(hr, vr) >= 3 and size == hr + vr - 1:\n                best = max(best, min(hr, vr))\n        if best:\n            ls.append((size, col, comp))\n    if not ls:\n        return g\n    ls.sort(reverse=True)\n    size, C, comp = ls[0]\n    best = None\n    for (y, x) in comp:\n        hr = 1\n        xx = x - 1\n        while (y, xx) in comp: hr += 1; xx -= 1\n        xx = x + 1\n        while (y, xx) in comp: hr += 1; xx += 1\n        vr = 1\n        yy = y - 1\n        while (yy, x) in comp: vr += 1; yy -= 1\n        yy = y + 1\n        while (yy, x) in comp: vr += 1; yy += 1\n        m = min(hr, vr)\n        if best is None or m > best[0]:\n            best = (m, y, x)\n    _, cy, cx = best\n    dy = 1 if any((y, cx) in comp for y in range(cy + 1, h)) else -1\n    dx = 1 if any((cy, x) in comp for x in range(cx + 1, w)) else -1\n    oy, ox = -dy, -dx\n    gy = h - 1 if oy == 1 else 0\n    gx = w - 1 if ox == 1 else 0\n    bestt = None\n    for sz, col2, comp2 in objs:\n        if comp2 is comp:\n            continue\n        cells = [(y, x) for (y, x) in comp2 if (y - cy) * oy > 0 and (x - cx) * ox > 0]\n        if not cells:\n            continue\n        d = min((y - gy) ** 2 + (x - gx) ** 2 for y, x in cells)\n        if bestt is None or d < bestt[0]:\n            bestt = (d, comp2)\n    if bestt:\n        for y, x in bestt[1]:\n            g[y][x] = C\n    return g\n```\n\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit","correct":true}}]}