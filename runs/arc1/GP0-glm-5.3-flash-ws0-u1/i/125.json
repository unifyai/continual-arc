bda i, c: i, h),\n            (\"diag\", lambda i, c: c - i, w + h),\n            (\"adiag\", lambda i, c: c + i, w + h)]\n    for name, kf, maxp in keys:\n        for p in range(1, maxp + 1):\n            vals = {}\n            ok = True\n            for i in range(h):\n                row = grid[i]\n                for c in range(w):\n                    v = row[c]\n                    if v == 0:\n                        continue\n                    r = kf(i, c) % p\n                    if r in vals:\n                        if vals[r] != v:\n                            ok = False\n                            break\n                    else:\n                        vals[r] = v\n                if not ok:\n                    break\n            if ok and len(vals) == p:\n                if name == \"row\":\n                    P = [vals[r] for r in range(p)]\n                    return [[P[i % p]] * w for i in range(h)]\n                return [[vals[kf(i, c) % p] for c in range(w)] for i in range(h)]\n    return [row[:] for row in grid]\n```\n\n{\"action\": \"submit\"}","steps":[],"action":{"type":"submit","correct":true}}]}