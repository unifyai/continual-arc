ext(v for row in grid for v in row if v not in (0, 9))\n    cells = [(r, c) for r in range(h) for c in range(w) if grid[r][c] == color]\n    r0, c0 = min(r for r, c in cells), min(c for r, c in cells)\n    shape = {(r-r0, c-c0) for r, c in cells}\n    mh, mw = max(r for r, c in shape)+1, max(c for r, c in shape)+1\n    out = [row[:] for row in grid]\n    for r in range(h-mh+1):\n        for c in range(w-mw+1):\n            # Repeat the seed motif only when every motif cell lands on background.\n            if all(grid[r+dr][c+dc] == 0 for dr, dc in shape):\n                for dr, dc in shape:\n                    out[r+dr][c+dc] = color\n    return out\n```\n{\"action\":\"submit\"}","steps":[],"action":{"type":"submit"}}]}