  h, w = len(grid), len(grid[0])\n    from collections import Counter, deque\n\n    bg = Counter(v for row in grid for v in row).most_common(1)[0][0]\n    seen = set()\n    comps = []\n\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] == bg or (r, c) in seen:\n                continue\n            color = grid[r][c]\n            q = deque([(r, c)])\n            seen.add((r, c))\n            cells = set()\n            while q:\n                y, x = q.popleft()\n                cells.add((y, x))\n                for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    ny, nx = y + dy, x + dx\n                    if (0 <= ny < h and 0 <= nx < w and\n                            grid[ny][nx] == color and (ny, nx) not in seen):\n                        seen.add((ny, nx))\n                        q.append((ny, nx))\n            comps.append((color, cells))\n\n    # Find the long L-shaped component that serves as the color indicator.\n    cues = []\n    for color, cells in comps:\n        if len(cells) < 5:\n            continue\n        for cr, cc in cells:\n            rows = {r for r, _ in cells}\n            cols = {c for _, c in cells}\n            if len(rows) != 1 or len(cols) != 1:\n                continue\n            expected = {(cr, c) for c in range(w) if (cr, c) in cells}\n            expected |= {(r, cc) for r in range(h) if (r, cc) in cells}\n            if expected == cells and len(expected) == len(cells):\n                # Verify both arms have meaningful length.\n                if sum(r == cr for r, c in cells) >= 3 and sum(c == cc for r, c in cells) >= 3:\n                    cues.append((color, cells))\n                    break\n\n    if not cues:\n        return [row[:] for row in grid]\n\n    cue_color, cue = max(cues, key=lambda item: len(item[1]))\n    candidates = [(color, cells) for color, cells in comps\n                  if cells != cue and len(cells) > 1]\n    if not candidates:\n        return [