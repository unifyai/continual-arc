+def warming_up(run: Path, k: int, start_after: int) -> bool:
+    """Whether phase ``k`` trains nothing, rounds 0..k having played fewer than ``start_after`` games: its adapter is
+    then the untrained one, the base model's own weights. The count only grows with k, so every such phase comes
+    before the first that trains, and the model it leaves in place is the base model."""
+    return games_played(run, k + 1) < start_after
