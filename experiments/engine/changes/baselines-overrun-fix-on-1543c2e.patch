 # limits) carry no such marker and pass straight through. 25 Sep 2026: Alibaba, the one provider of a hosted model in the capability probe, refused
 # half of all calls at random ("AccessDenied.Unpurchased"), a coin flip per request.
 PROVIDER_REFUSAL = b"Provider returned error"
+# The fields a chat completion asks its reply budget in, and the mark of a refusal for the room it asks: vLLM's "This
+# model's maximum context length is 131072 tokens. However, you requested 65536 output tokens and your prompt contains
+# 70000 input tokens ...". A call refused only because its prompt and the budget it asks together pass the window is
+# sent once more without the budget, so that the server gives the reply the room the window has left: the paper's
+# player asks the same budget at every call, which vLLM refuses once a conversation passes the window less the budget
+# (continual-arc-paper notes/readings/context-overrun-2026-11-04.txt; the release's proxy does the same). A prompt that
+# fills the window alone is still refused. The captured request is what the server received, the budget left out.
+REPLY_BUDGETS = ("max_tokens", "max_completion_tokens")
+WINDOW_REFUSAL = b"maximum context length"
 # The keys chat templates read an assistant turn's reasoning from (K2 Horizon's reads all five, in this order).
