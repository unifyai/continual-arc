+def greater(
+    a: Integer,
+    b: Integer
+) -> Boolean:
+    """ greater """
+    return a > b
+
+def size(
+    container: Container
+) -> Integer:
+    """ cardinality """
+    return len(container)
+
+def merge(
+    containers: ContainerContainer
+) -> Container:
+    """ merging """
+    return type(containers)(e for c in containers for e in c)
