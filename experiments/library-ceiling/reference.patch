+def test_rows_hpb_and_hpb0_are_given_c1_then_the_building_block_library_kept_and_wiped(tmp_path, monkeypatch):
+    from continual_arc_baselines.systems.prime_agent import PrimeAgentLearner
+    hpb, _ = _played(monkeypatch, reference.play_round, "glm", "hpb", tmp_path / "hpb", ONE_USER, api_key="k")
+    hpb0, _ = _played(monkeypatch, reference.play_round, "glm", "hpb0", tmp_path / "hpb0", ONE_USER, api_key="k")
+    kept, wiped = PrimeAgentLearner(**hpb), PrimeAgentLearner(**hpb0)
+    for system in (kept, wiped):
+        assert system.block_library and not system.program_library and system.end == "finish"
+        assert system.rules_page == paper.rules_page("c1")
+        assert "built from reusable building blocks" in system.library_rules()
+    assert not kept.stateless and wiped.stateless
+    assert json.loads((tmp_path / "hpb" / "driver.json").read_text())["harness"]["block_library"] is True
+    assert json.loads((tmp_path / "hpb0" / "driver.json").read_text())["stateless"]
+
+
+def test_the_library_ceilings_rows_are_hpl0_given_the_streams_primitives_and_play_from_a_driver_alone(tmp_path,
+                                                                                                    monkeypatch):
+    from types import SimpleNamespace as Namespace
+
+    from continual_arc_baselines.systems.prime_agent import PrimeAgentLearner
+    for row, module in (("hpl0d1", "stream_u1"), ("hpl0d4", "stream_u4")):
+        harness, _ = _played(monkeypatch, reference.play_round, "glm", row, tmp_path / row, ONE_USER, api_key="k")
+        system = PrimeAgentLearner(**harness)
+        assert system.primitives == module and system.program_library and system.stateless
+        assert system.rules_page == paper.rules_page("c1") and "A library of grid primitives" in system.primitives_note()
+        played = json.loads((tmp_path / row / "driver.json").read_text())
+        reference.cmd_driver(Namespace(player="glm", row=row, run_dir=str(tmp_path / f"{row}-alone")))
+        alone = json.loads((tmp_path / f"{row}-alone" / "driver.json").read_text())
+        # the plays-only run records what a stream of the row would, but its users mode, and that it has no stream
+        assert {k: v for k, v in alone.items() if k != "stream"} == {k: v for k, v in played.items() if k in alone}
+        assert alone["harness"]["primitives"] == module and alone["stream"].startswith("none")
+
+
