+def cmd_driver(a: argparse.Namespace) -> None:
+    """A run of a row's frozen tests alone, with no stream (rows hpl0d1 and hpl0d4, the module's docstring): its
+    driver.json in ``--run-dir``, as play_round writes a stream's, which frozen.py reads the row from."""
