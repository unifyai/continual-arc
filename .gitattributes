# The runs are data, browsed and cloned in git; the source archives GitHub serves for a commit or a release, which the
# verified-run runners re-sync from, hold the code alone.
/runs/** export-ignore
# The private engine's revisions the experiments ran on (experiments/engine/README.md), 40 MB of record, are browsed and
# cloned in git too; the source archives leave them out with the runs.
/experiments/engine/** export-ignore
